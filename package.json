{
  "name": "multicarrinho-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Protótipo de portfólio: compare cardápios de várias lojas de delivery e peça montagens com um agente de IA (Claude).",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c red,gray \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "vite": "^8.3.7"
  },
  "license": "MIT"
}
