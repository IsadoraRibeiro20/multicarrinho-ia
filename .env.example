# Copie para .env e preencha. O arquivo .env não vai para o Git.

# Chave da API da Anthropic (https://console.anthropic.com/). Sem ela, o app usa o motor local.
ANTHROPIC_API_KEY=

# Opcional: modelo usado pelo agente (padrão: claude-opus-5-5).
# CLAUDE_MODEL=claude-opus-5-5

# Opcional: pedidos por IP a cada 10 minutos (padrão: 20).
# RATE_LIMIT_MAX=20

# Opcional: porta do servidor (padrão: 3001).
# PORT=3001
